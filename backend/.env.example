# IdeaSpark Django Environment Template
# Copy to .env and adjust for your environment
# cp .env.example .env

# ── Django Core ──
DJANGO_SECRET_KEY=generate-a-random-secret-key-here
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ideaspark
DB_USERNAME=root
DB_PASSWORD=root
DB_CONN_MAX_AGE=600
DB_CONN_TIMEOUT=30

# ── JWT ──
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRE_SECONDS=604800
JWT_REFRESH_EXPIRE_SECONDS=2592000
JWT_ISSUER=ideaspark

# ── CORS ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── OSS (Aliyun) ──
OSS_ENABLED=true
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=ideaspark
OSS_BASE_DIR=uploads

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.7
DEEPSEEK_MAX_TOKENS=2000
DEEPSEEK_CONNECT_TIMEOUT=30000
DEEPSEEK_READ_TIMEOUT=60000

# ── Email (SMTP) ──
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=your_email@gmail.com
# EMAIL_HOST_PASSWORD=your_app_password
# DEFAULT_FROM_EMAIL=your_email@gmail.com

# ── Frontend ──
FRONTEND_URL=http://localhost:5173

# ── Logging ──
LOG_LEVEL=INFO
APP_LOG_LEVEL=DEBUG
LOG_FILE_PATH=logs/ideaspark.log

# ── Server (Gunicorn) ──
SERVER_PORT=9001
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000
