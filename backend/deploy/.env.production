# =============================================================================
# IdeaSpark 生产环境变量模板
# 使用方式：在 1Panel 中创建 Compose 项目时，复制此文件内容到环境变量配置
# 或保存为 .env 与 docker-compose.yml 同目录
# =============================================================================

# ── Django Core ──
DJANGO_SECRET_KEY=<生成一个随机密钥，至少50位字符>
DJANGO_DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,你的域名或IP

# ── Database (MySQL) ──
DB_HOST=你的MySQL地址
DB_PORT=3306
DB_NAME=ideaspark
DB_USERNAME=ideaspark
DB_PASSWORD=你的数据库密码

# ── JWT ──
JWT_SECRET=<生成一个随机密钥，至少32位字符>

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://你的前端域名,http://你的前端域名

# ── OSS (Aliyun) ──
OSS_ENABLED=true
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=你的OSS AccessKey
OSS_ACCESS_KEY_SECRET=你的OSS Secret
OSS_BUCKET=ideaspark
OSS_BASE_DIR=uploads

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=你的DeepSeek API Key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Email (SMTP) ──
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=你的邮箱
EMAIL_HOST_PASSWORD=你的邮箱密码或App Password
DEFAULT_FROM_EMAIL=你的邮箱

# ── Frontend URL ──
FRONTEND_URL=https://你的前端域名

# ── Server ──
SERVER_PORT=9001
GUNICORN_WORKERS=4
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO
