{
  "name": "ideaspark-frontend",
  "private": true,
  "version": "0.0.0",
  "description": "IdeaSpark 前端项目（Vue 3 + Vite + TypeScript）",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "typecheck": "vue-tsc -b --noEmit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "deploy:docker": "cd deploy && ./deploy.sh docker",
    "deploy:nginx": "cd deploy && ./deploy.sh nginx",
    "deploy:preview": "cd deploy && ./deploy.sh preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vicons/carbon": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "axios": "^1.13.2",
    "echarts": "^6.0.0",
    "gsap": "^3.13.0",
    "lucide-vue-next": "^1.0.0",
    "naive-ui": "^2.43.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.24",
    "vue-lazyload": "^3.0.0",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.0.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "happy-dom": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "sass": "^1.94.2",
    "terser": "^5.46.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.18.0",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.2.4",
    "vite-imagetools": "^9.0.2",
    "vitest": "^3.0.0",
    "vue-tsc": "^3.1.4"
  }
}
